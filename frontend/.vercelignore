# Vercel ignore file for frontend

# Dependencies
node_modules

# Environment files (keep .env.production for build)
.env.local
.env.development.local
.env.test.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by tools like istanbul
coverage

# IDE files
.vscode
.idea
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp