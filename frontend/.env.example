# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
# For production:
# REACT_APP_API_URL=https://yourdomain.com/api
# or
# REACT_APP_API_URL=https://api.yourdomain.com

# App Configuration
REACT_APP_APP_NAME=VTOP Academic Portal
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=VIT on TOP - Academic Portal for Students, Faculty and Staff

# Environment
REACT_APP_ENV=development

# Features Toggle
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false

# Analytics (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=your-ga-id-here
REACT_APP_HOTJAR_ID=your-hotjar-id-here

# Error Reporting (Optional)
REACT_APP_SENTRY_DSN=your-sentry-dsn-here

# Social Login (Optional)
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_FACEBOOK_APP_ID=your-facebook-app-id

# Map Integration (Optional)
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# File Upload
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Theme Configuration
REACT_APP_PRIMARY_COLOR=#1e3c72
REACT_APP_SECONDARY_COLOR=#2a5298
REACT_APP_THEME=light

# Notification Configuration
REACT_APP_NOTIFICATION_TIMEOUT=5000
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=false

# Performance
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_CACHE_STRATEGY=cacheFirst

# Development
REACT_APP_DEBUG=false
REACT_APP_MOCK_API=false