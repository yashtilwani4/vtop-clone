# VTOP Academic Portal - .gitignore

# ===================================
# Environment Variables & Secrets
# ===================================
.env
.env.local
.env.development.local
.env.test.local
# Note: .env.production files are kept for deployment templates

# JWT Secrets and API Keys
jwt-secret.txt
api-keys.txt
secrets/

# ===================================
# Node.js Dependencies
# ===================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Package manager files (keep package-lock.json for consistent deployments)
# package-lock.json  # Commented out - keep for deployment consistency
yarn.lock
pnpm-lock.yaml

# ===================================
# Build Outputs
# ===================================
# Frontend build
frontend/build/
frontend/dist/
frontend/.next/
frontend/out/

# Backend build
backend/build/
backend/dist/

# Static files
static/
public/build/

# ===================================
# Logs
# ===================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output/

