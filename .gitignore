performance-logs/

# ===================================
# Keep These Files (Exceptions)
# ===================================
# Keep example environment files
!.env.example
!backend/.env.example
!frontend/.env.example

# Keep production environment templates (but not actual production secrets)
!.env.production
!backend/.env.production
!frontend/.env.production

# Keep package lock files for consistent deployments
!package-lock.json
!backend/package-lock.json
!frontend/package-lock.json

# Keep important config files
!vercel.json
!frontend/vercel.json
!render.yaml
!ecosystem.config.js
!docker-compose.yml
!Dockerfile
!backend/Dockerfile
!frontend/Dockerfile

# Keep documentation
!README.md
!DEPLOYMENT_GUIDE.md
!VERCEL_RENDER_DEPLOYMENT.md
!DEPLOYMENT_CHECKLIST.md
!QUICK_START.md
!*.md

# Keep essential scripts
!deploy.sh
!deploy-vercel-render.sh

# Keep nginx configuration
!nginx/
!nginx.conf